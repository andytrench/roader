# Copy to configs/pilot.toml and edit paths / bbox for your AOI.
# AOI should include: urban street, on-ramp/clover, simple bridge, rural road.

[pilot]
name = "pilot_v0"
# WGS84: west, south, east, north
bbox = [-71.10, 42.30, -71.05, 42.34]
# Projected CRS matching the LiDAR file (Massachusetts Mainland example)
crs = "EPSG:26986"
lidar_path = "data/pilot/lidar.laz"
# Optional NAIP GeoTIFF (used in later sidewalk inference)
naip_path = "data/pilot/naip.tif"
output_gpkg = "data/pilot/out_roads.gpkg"
osm_network_type = "drive"
deck_height_above_ground_m = 2.5
pavement_thickness_m = 0.2
deck_thickness_m = 0.8
sidewalk_infer = true
